# Servidor
PORT=3001
# Obligatorio: el servidor no arranca sin esta variable. Genera un valor propio y aleatorio,
# por ejemplo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Nunca reutilices un valor que haya estado en este archivo de ejemplo ni en el control de versiones.
SECRET_KEY=

# Opcional: restringe qué origen puede llamar a la API (dominio del frontend en producción).
# Si se deja vacío, se permite cualquier origen (recomendado solo en desarrollo local).
ALLOWED_ORIGIN=

# Base de Datos (MySQL)
# Railway proporciona estas variables automáticamente
MYSQLHOST=localhost
MYSQLUSER=root
MYSQLPASSWORD=
MYSQLDATABASE=erp_db
MYSQLPORT=3306
